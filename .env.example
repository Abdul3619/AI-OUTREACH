# Copy this file to .env for local runs. On a host like Render, set these
# as environment variables in the dashboard instead — there is no .env
# file there, and that's fine (server/index.ts only tries to read one).
# Never commit the real .env file (it's already in .gitignore).

# --- Gemini (required for drafting) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for drafting outreach emails. Google renames/retires models
# fairly often — before running this for real, check the current list at
# https://ai.google.dev/gemini-api/docs/models and update this if needed.
# This default was verified working as of when this app was built.
GEMINI_MODEL=gemini-3-flash-preview

# --- Server ---
# Render sets PORT itself — you don't need to set this on Render.
PORT=3000

# --- Supabase (required — this app has no other storage backend) ---
# Reuses the SAME Supabase project as the portfolio/Agbada Luxe sites
# (this account is capped at 2 free projects). All of this app's tables
# are prefixed ai_outreach_ so they don't collide with the existing ones.
#
# IMPORTANT: only ever put the PUBLIC anon/publishable key here — never
# the service-role secret key. Every table has Row Level Security enabled
# with no direct policies; the anon key can only call this app's specific
# SECURITY DEFINER functions (see supabase/migration.sql), never query a
# table directly, so it's safe to hand to a third-party host.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Compliance footer (added to every drafted email) ---
# Fill these in with YOUR real business name and mailing address.
# Required for CAN-SPAM (US) if you ever email US-based leads, and good
# practice everywhere. See README.md "Compliance" section before scaling up.
SENDER_BUSINESS_NAME=Your Business Name
SENDER_ADDRESS=Your City, Your Country

# --- OpenStreetMap auto-search (no API key needed, but be a good citizen) ---
# Nominatim's usage policy requires a real identifying contact in requests.
# https://operations.osmfoundation.org/policies/nominatim/
OSM_CONTACT_EMAIL=you@example.com
