# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it's already in .gitignore).

# --- Gemini (required for drafting) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for drafting outreach emails. Google renames/retires models
# fairly often — before running this for real, check the current list at
# https://ai.google.dev/gemini-api/docs/models and update this if needed.
# This default was verified working as of when this app was built.
GEMINI_MODEL=gemini-3-flash-preview

# --- Server ---
PORT=3000

# Where the SQLite database file lives. Created automatically on first run.
DATABASE_FILE=./data/ai-outreach.sqlite

# --- Compliance footer (added to every drafted email) ---
# Fill these in with YOUR real business name and mailing address.
# Required for CAN-SPAM (US) if you ever email US-based leads, and good
# practice everywhere. See README.md "Compliance" section before scaling up.
SENDER_BUSINESS_NAME=Your Business Name
SENDER_ADDRESS=Your City, Your Country

# --- OpenStreetMap auto-search (no API key needed, but be a good citizen) ---
# Nominatim's usage policy requires a real identifying contact in requests.
# https://operations.osmfoundation.org/policies/nominatim/
OSM_CONTACT_EMAIL=you@example.com
